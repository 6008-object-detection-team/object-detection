* text=auto eol=lf
*.bat text eol=crlf
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.ts filter=lfs diff=lfs merge=lfs -text
*.part[0-9][0-9][0-9] filter=lfs diff=lfs merge=lfs -text
*.pyz filter=lfs diff=lfs merge=lfs -text
# Preserve recorded dataset hashes on Windows and Linux.
# Archived experiment files must retain their exact original bytes, including
# CSV files emitted with CRLF, rather than being rewritten by Git.
work/** -text
